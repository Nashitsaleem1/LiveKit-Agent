[Unit]
Description=Ava mock company API (sample data, read-only)
After=network.target

[Service]
User=ava
Group=ava
WorkingDirectory=/opt/ava/app
EnvironmentFile=/etc/ava/ava.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ava/app/.venv/bin/python mocks/internal_api.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
