LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# on (default) or off. Turn off on slow dev machines if speech sounds choppy.
NOISE_CANCELLATION=on

# Internal company API (read-only token only)
INTERNAL_API_URL=http://127.0.0.1:8081
INTERNAL_API_TOKEN=

# Claude webhook: shared HMAC secret, also configured on the Claude side
CLAUDE_WEBHOOK_URL=http://127.0.0.1:8082/skills/run
CLAUDE_WEBHOOK_SECRET=
CLAUDE_WEBHOOK_TIMEOUT=90

# Agent deployment: empty = production (server). For lk agent dev locally, e.g. dev-local
LIVEKIT_AGENT_DEPLOYMENT=

# Web call page
WEB_PASSCODE=
WEB_HOST=127.0.0.1
WEB_PORT=8090
